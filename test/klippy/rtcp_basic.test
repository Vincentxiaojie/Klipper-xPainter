# RTCP (Rotation Tool Center Point) test — BC configuration
# B around Y (tilt), C around Z (rotation)
# tool_length = 80mm
#
# RTCP math (BC) — 2026-05-29 sign fixed:
#   X_pivot = X_tip - L*sin(B)*cos(C)
#   Y_pivot = Y_tip - L*sin(B)*sin(C)
#   Z_pivot = Z_tip + L*cos(B)
#
# At B=0: pivot Z = tip Z + 80. So tip Z >= 80 keeps pivot Z >= 0.

DICTIONARY linuxprocess.dict
CONFIG rtcp.cfg

# Home all axes to establish pivot origin
G28 X Y Z B C

# Reset display coordinates (tip space)
G92 X0 Y0 Z0 B0 C0

# Move to safe working position: tip at Z=80 (pivot at Z=0)
G1 X100 Z80 F6000

# Reset tip coordinates for verification
G92 X100 Y0 Z80 B0 C0

# === Test: B=30 tilt (笔向右倾斜) ===
# Tip: (100, 0, 80, 0, 0) → (100, 0, 80, 30, 0)
# Pivot: X=100-80*sin30*cos0=60, Y=0, Z=80+80*cos30=149.282
G1 B30 F600

# Return B to 0
G1 B0 F600

# === Test: C=90 at B=0 (vertical = no RTCP effect on XYZ) ===
# Tip: (100, 0, 80, 0, 0) → (100, 0, 80, 0, 90)
# Pivot: Z=80+80*cos0=160, XYZ unchanged from vertical
G1 C90 F600

# Return C to 0
G1 C0 F600

# === Test: B=30 C=90 (笔向右前方倾斜) ===
# Tip: (100, 0, 80, 0, 0) → (100, 0, 80, 30, 90)
# Pivot: X=100-80*sin30*cos90=100, Y=0-80*sin30*sin90=-40, Z=80+80*cos30=149.282
G1 B30 C90 F600

# Return to zero
G1 B0 C0 F600

# Query final position
M114

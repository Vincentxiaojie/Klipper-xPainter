# Seven-axis pulse accuracy test (XYZABCE)
# Verifies stepper step counts for each of the 7 axes
#
# Step distance calculations from five_axis.cfg:
#   X, Y: rotation_distance=40, microsteps=16, step_dist=0.0125 mm/step
#   Z:    rotation_distance=8,  microsteps=16, step_dist=0.0025 mm/step
#   A,B,C: rotation_distance=360, full_steps_per_rotation=200, microsteps=16
#          step_dist = 360/3200 = 0.1125 deg/step
#   E:    rotation_distance=33.5, microsteps=16, step_dist=0.01046875 mm/step
#
# Expected step counts:
#   G1 X100 = 100/0.0125 = 8000 steps
#   G1 Y50  = 50/0.0125  = 4000 steps
#   G1 Z10  = 10/0.0025  = 4000 steps
#   G1 A90  = 90/0.1125  = 800 steps
#   G1 B90  = 90/0.1125  = 800 steps
#   G1 C90  = 90/0.1125  = 800 steps
#   G1 E10  = 10/0.01046875 = ~955 steps

DICTIONARY linuxprocess.dict
CONFIG five_axis.cfg

# Home XYZ and reset all axes to zero
G28 X Y Z
G92 X0 Y0 Z0 A0 B0 C0 E0

# Test X: 100mm = 8000 steps
G1 X100 F6000
M114

# Test Y: 50mm = 4000 steps
G1 Y50 F6000
M114

# Test Z: 10mm = 4000 steps
G1 Z10 F1500
M114

# Test A: 90deg = 800 steps
G1 A90 F6000
M114

# Test B: 90deg = 800 steps
G1 B90 F6000
M114

# Test C: 90deg = 800 steps
G1 C90 F6000
M114

# Test E: 10mm = ~955 steps
G1 E10 F1500
M114

# Query final state
GET_POSITION
